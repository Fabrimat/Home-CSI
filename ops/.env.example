# Home CSI — environment file for ops/docker-compose.yml (and the override file).
#
# Copy this to `.env` in the `ops/` directory and fill in real values:
#   cp ops/.env.example ops/.env
#
# `.env` is git-ignored (see repo-root .gitignore) - never commit real secrets.
#
# This file alone is NOT a complete deployment: the per-node PSK registry
# and the application log file path have no environment-variable override
# (see server/packages/config/src/env.ts), so a real `config.yaml` is
# also mandatory. See `ops/config.production.example.yaml` and
# docs/deployment.md step 7 for that file - do this file and that file
# together, not one or the other.
#
# --- How to generate strong secrets ---
# For the Postgres password and the API bearer token, use a cryptographically
# random value, e.g. on Linux/macOS/WSL:
#   openssl rand -base64 32
# or:
#   openssl rand -hex 32
# Avoid shell history leaking the value: prefix the command with a space if
# your shell's HISTCONTROL is set to ignorespace, or run `history -d <n>`
# afterwards. Per-node CSI pre-shared keys are generated separately - see
# docs/deployment.md ("Key management").

# ---------------------------------------------------------------------------
# Postgres / TimescaleDB
# ---------------------------------------------------------------------------

# Postgres superuser/app role name used by the timescaledb container and by
# the server's DB connection (mapped in via HOMECSI_DATABASE_USER — see
# `x-app-env` in ops/docker-compose.yml).
POSTGRES_USER=homecsi

# Postgres password for POSTGRES_USER. Generate with `openssl rand -base64 32`.
# CHANGE THIS - the placeholder below is not safe to deploy with.
POSTGRES_PASSWORD=changeme-generate-a-real-secret

# Database name used by both the migrate/ingest/api containers.
POSTGRES_DB=homecsi

# ---------------------------------------------------------------------------
# Home CSI application
# ---------------------------------------------------------------------------

# Bearer token required by the `api` (serve) service's REST + WebSocket debug
# API. Generate with `openssl rand -base64 32`. Anyone with this token has
# full read access to the debug API - treat it like a password. Named to
# match server/packages/config/src/env.ts's `HOMECSI_SERVER_API_TOKEN`
# override directly (the compose anchor passes it through unchanged) -
# see server/packages/config/src/opsEnvDrift.test.ts for the test that
# keeps this file and env.ts from drifting apart again.
HOMECSI_SERVER_API_TOKEN=changeme-generate-a-real-secret

# UDP port the `ingest` service listens on and publishes to the world. Must
# match the port every node's firmware is configured to send to. Default
# matches docs/deployment.md and docs/protocol.md discussion; change only if
# you have a documented reason to (e.g. port already in use on the VPS).
# Kept as `HOMECSI_UDP_PORT` (not renamed to match env.ts's
# `HOMECSI_SERVER_UDP_PORT`) because `ops/hardening/harden.sh` also reads
# this exact name for its firewall rule - the compose anchor maps it to
# the app's real override name (`HOMECSI_SERVER_UDP_PORT:
# ${HOMECSI_UDP_PORT:-5566}`) so both consumers stay happy with one value.
HOMECSI_UDP_PORT=5566

# Absolute path on the VPS host where captures/, logs/, and db-adjacent
# application data are stored. Mounted into the ingest/api containers as
# /data. Must exist and be writable by the container's non-root user (the
# Dockerfile creates /data with permissive-enough ownership inside the
# image, but the *host* directory's ownership/permissions are up to you -
# see docs/deployment.md "Disk management"). Compose/host-only - not
# forwarded into any container's environment (nothing inside the
# containers reads a HOMECSI_DATA_DIR variable; the containers only ever
# see the fixed in-container path `/data`).
HOMECSI_DATA_DIR=/srv/homecsi/data

# Log verbosity passed through to the CLI (matches whatever levels the
# server's logger supports, e.g. debug/info/warn/error). Optional - defaults
# to "info" in the compose file if unset. Named to match
# server/packages/config/src/env.ts's `HOMECSI_LOGGING_LEVEL` override
# directly.
HOMECSI_LOGGING_LEVEL=info

# ---------------------------------------------------------------------------
# Firewall / hardening (read by ops/hardening/harden.sh only - NOT read by
# docker compose or the app itself). Source this file before running
# harden.sh to reuse the same values, e.g.:
#   set -a; source ops/.env; set +a; sudo -E ops/hardening/harden.sh
# ---------------------------------------------------------------------------

# Sustained per-source-IP packet ceiling (packets/second) for the UDP
# ingest port's rate limiter. Default 1000 pps is sized for the full 9-node
# design envelope (~600 kbps aggregate, assumed ~300-byte average datagram)
# arriving from ONE shared home WAN IP, with a 4x headroom multiple over
# the ~250 pps that arithmetic implies - see the "Sizing arithmetic"
# comment in ops/hardening/harden.sh section 3 for the full derivation.
# Raise this (and re-run harden.sh) if legitimate traffic is getting
# throttled - see docs/deployment.md "Troubleshooting" for how to tell.
HOMECSI_UDP_RATE_LIMIT_PER_SEC=1000

# Burst allowance (packet count) on top of the sustained ceiling above.
# Default 2000 = 2 seconds at the default ceiling, sized to absorb several
# nodes reconnecting and flushing pending batches near-simultaneously
# after a shared AP hiccup. Both defaults above are the actual enforced
# values (the firewall rule evaluates each packet exactly once against
# the enforcement bucket - see the "Accounting" note in
# ops/hardening/harden.sh section 3 for why that is guaranteed, not just
# assumed).
HOMECSI_UDP_RATE_LIMIT_BURST=2000

# ---------------------------------------------------------------------------
# Backups (read by ops/backup.sh only - NOT read by docker compose or the
# app itself; same "source this file, don't `docker compose up` it" status
# as the firewall/hardening section above)
# ---------------------------------------------------------------------------

# How many days of ops/backup.sh's own dumps to keep under
# HOMECSI_DATA_DIR/backups before pruning the oldest. Optional - defaults
# to 14 if unset. Does not affect anything already synced off this VPS
# (see docs/deployment.md "Backup and restore" for why off-VPS copies are
# still on you to arrange).
HOMECSI_BACKUP_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Caddy / TLS
# ---------------------------------------------------------------------------

# Public DNS domain (A/AAAA record) pointing at this VPS. Caddy requests and
# renews a Let's Encrypt certificate for this exact name - it must already
# resolve to the VPS's public IP before you start caddy, or issuance fails.
HOMECSI_DOMAIN=homecsi.example.com

# Email address Let's Encrypt uses for expiry/problem notifications about
# the certificate above. Not published or exposed to visitors.
HOMECSI_ACME_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Build/misc
# ---------------------------------------------------------------------------

# Tag applied to the locally-built server image (homecsi-server:<tag>).
# Optional - defaults to "local" in the compose file if unset. Bump this
# (e.g. to a git SHA) if you want distinguishable images across deploys.
HOMECSI_IMAGE_TAG=local
