# sdkconfig.defaults - Home CSI node, settings common to every target.
#
# Every setting here is load-bearing; the comment says why. Anything not
# listed is left at the ESP-IDF default on purpose.
#
# ESP-IDF merges this file with exactly one of sdkconfig.defaults.esp32c6 /
# sdkconfig.defaults.esp32, depending on the resolved target - that is
# ESP-IDF's own standard per-target sdkconfig.defaults mechanism, not
# something this project invented. esp32c6 is the primary/documented target
# (the operator is moving the fleet from Makeblock Halocode (ESP32) boards to
# ESP32-C6); esp32 stays buildable for whichever legacy Halocode boards are
# still in service. See docs/hardware-esp32c6.md and
# docs/hardware-halocode.md for what is actually known about each board, and
# the per-target files below for what differs between them and why.

# PINNED DEFAULT TARGET. A fresh checkout with no existing (gitignored,
# machine-local) `sdkconfig` and no `IDF_TARGET` environment variable builds
# for esp32c6 with a plain `idf.py build` - ESP-IDF reads CONFIG_IDF_TARGET
# out of sdkconfig.defaults for exactly this "first build, no prior choice
# made yet" case. Without this line the fallback the moment nobody has typed
# `idf.py set-target` is ESP-IDF's own built-in default, which is plain
# esp32 - the wrong board for this project's primary target, and a
# particularly easy trap for the operator this brief is for, who spent years
# being told to type `idf.py set-target esp32` for the Halocode.
#
# Run `idf.py set-target esp32` to build for a legacy Halocode board instead;
# that choice is written into the gitignored, machine-local `sdkconfig` and
# persists across builds (including future plain `idf.py build` runs in that
# same build directory) until `set-target` is run again.
CONFIG_IDF_TARGET="esp32c6"

# NOTE: these have been written against ESP-IDF v5.x symbol names but have
# NOT been validated by an actual build (no IDF toolchain was available when
# this was written). If `idf.py build` warns that a symbol is unknown, that
# is a rename between IDF versions, not a design decision - check
# firmware/bringup/README.md.

# --- partition table ---------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# 4 MB, because partitions.csv is now an A/B OTA layout (otadata + ota_0 +
# ota_1) and that does not fit in 2 MB at any sane app size.
#
# THIS IS A HARDWARE PREREQUISITE, NOT A TUNING KNOB, AND NOT A TARGET-
# SPECIFIC ONE: it depends on the flash chip actually soldered to the board
# in hand, which varies by module/vendor on both the legacy Halocode and the
# new C6 boards alike. Run `esptool.py flash_id` and confirm 4 MB before
# flashing this to ANY board, ESP32 or ESP32-C6; a 2 MB part with this table
# will not boot. See the header of partitions.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_DETECT=y

# --- OTA ---------------------------------------------------------------
# Rollback: a freshly installed image boots as PENDING_VERIFY and the
# bootloader reverts to the other slot on the next reboot unless the app calls
# esp_ota_mark_app_valid_cancel_rollback(). main/ota.c calls it only after the
# node has associated AND sent a heartbeat. Without this symbol a bad image
# just stays, which for a node behind a wall is the expensive outcome.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Certificate bundle: gives esp-tls the Mozilla root store so
# esp_crt_bundle_attach() in main/ota.c can actually validate the server's
# certificate. Without it there are no trust anchors on the device and the
# esp_http_client_config_t.crt_bundle_attach field does not even exist.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# HTTPS-only OTA. main/ota.c also refuses an api_base that is not https://,
# so this is the belt to that braces - it costs nothing and closes the
# downgrade path if this module is ever moved onto esp_https_ota.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n
# SHA-256 in hardware: used by the image validation inside esp_ota_end() and
# by the manifest read-back check in main/ota.c, over ~2 MB each time. Both
# esp32 and esp32c6 have a hardware SHA accelerator exposed under this same
# Kconfig symbol.
CONFIG_MBEDTLS_HARDWARE_SHA=y

# --- Wi-Fi / CSI -------------------------------------------------------
# THE reason this project exists. Without it esp_wifi_set_csi() fails. Same
# symbol name on every Wi-Fi-capable ESP-IDF target, esp32c6 included.
CONFIG_ESP_WIFI_CSI_ENABLED=y
# Do not let the Wi-Fi driver persist its own config in NVS: node_config is
# the single source of truth and a stale stored SSID is a nasty ghost bug.
CONFIG_ESP_WIFI_NVS_ENABLED=n
# More static RX buffers => fewer CSI callbacks lost during bursts. Each is
# ~1.6 kB of internal RAM, so this is the main RAM/robustness knob. The
# classic ESP32 (520 kB SRAM) and the ESP32-C6 (512 kB SRAM) have close
# enough internal RAM budgets that this project is not giving this a
# per-target value - if bring-up on either board shows RAM pressure from
# this, that is a case for a per-target override, not a reason to guess one
# now.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# AMPDU RX on: HT frames from the AP are aggregated, and turning it off
# reduces the number of decodable HT frames (i.e. fewer CSI records).
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

# --- crypto ------------------------------------------------------------
# ChaCha20-Poly1305 per docs/protocol.md section 5.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y

# --- watchdogs ---------------------------------------------------------
# A wedged uplink or capture task must reboot the node, not sit there dark.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_INT_WDT=y

# --- FreeRTOS / timing -------------------------------------------------
# 1 kHz tick so the sounding scheduler and flush-time budget have millisecond
# granularity instead of 10 ms.
CONFIG_FREERTOS_HZ=1000

# --- size / logging ----------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# --- things we do not use ----------------------------------------------
# Both boards' Bluetooth stacks are entirely unused by this firmware, so this
# is off regardless of which one differs (classic BT+BLE on the ESP32,
# BLE-only on the ESP32-C6) - the difference is moot once the whole stack is
# disabled.
CONFIG_BT_ENABLED=n
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
